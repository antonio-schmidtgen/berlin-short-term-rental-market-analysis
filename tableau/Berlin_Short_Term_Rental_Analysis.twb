                </zone>
                <zone forceUpdate='true' h='12820' id='23' type-v2='text' w='21081' x='5486' y='86338'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='10'>  BUSINESS RECOMMENDATIONS</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#2f6fed' fontname='Tableau Regular'>1. Benchmark by District and Room Type</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff'>Price depends on both district and room type. Use comparable listings in the same area as benchmarks.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#333333' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='1' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='0' />
