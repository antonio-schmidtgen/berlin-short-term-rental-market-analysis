                <zone forceUpdate='true' h='12820' id='26' type-v2='text' w='19112' x='80302' y='86338'>
                  <formatted-text>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ff5400' fontname='Tableau Regular'>4. Read Price and Occupancy Together</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff'>Higher prices only create value when listings are booked. Always compare price and occupancy side by side.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='12' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
              <zone forceUpdate='true' h='12820' id='23' type-v2='text' w='21081' x='5486' y='86338'>
                <formatted-text>
                  <run bold='true' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='10'>  BUSINESS RECOMMENDATIONS</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#2f6fed' fontname='Tableau Regular'>1. Benchmark by District and Room Type</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff'>Price depends on both district and room type. Use comparable listings in the same area as benchmarks.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#333333' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='1' />
                  <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='12820' id='24' type-v2='text' w='19617' x='31769' y='86338'>
                <formatted-text>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#00b6a9' fontname='Tableau Regular'>2. Support Hosts to Superhost Status</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff'>Superhosts achieve much higher occupancy. Supporting hosts toward Superhost status may increase bookings.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='12' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='12820' id='25' type-v2='text' w='19544' x='56365' y='86338'>
                <formatted-text>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#2db300' fontname='Tableau Regular'>3. Monitor Low-Rated Listings</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff'>Most listings receive high ratings. Low-rated listings should be reviewed early to protect reputation.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
