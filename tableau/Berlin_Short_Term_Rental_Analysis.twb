                <zone forceUpdate='true' h='12820' id='24' type-v2='text' w='19617' x='31769' y='86338'>
                  <formatted-text>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#00b6a9' fontname='Tableau Regular'>2. Support Hosts to Superhost Status</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff'>Superhosts achieve much higher occupancy. Supporting hosts toward Superhost status may increase bookings.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
