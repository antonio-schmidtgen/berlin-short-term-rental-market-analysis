                <zone forceUpdate='true' h='12820' id='25' type-v2='text' w='19544' x='56365' y='86338'>
                  <formatted-text>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#2db300' fontname='Tableau Regular'>3. Monitor Low-Rated Listings</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff'>Most listings receive high ratings. Low-rated listings should be reviewed early to protect reputation.</run>
                  </formatted-text>
